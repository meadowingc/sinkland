<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <meta name="referrer" content="no-referrer">
    <title>{{ title }}</title>
    <style>
        body {
            font-family: Georgia, serif;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            line-height: 1.6;
            color: #333;
        }
        h1 {
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }
        p {
            margin-bottom: 20px;
            text-align: justify;
        }
        .links {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
        }
        .links h2 {
            color: #2c3e50;
            font-size: 1.2em;
        }
        .links ul {
            list-style: none;
            padding: 0;
        }
        .links li {
            margin: 10px 0;
        }
        .links a {
            color: #3498db;
            text-decoration: none;
            font-weight: 500;
        }
        .links a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <h1>{{ title }}</h1>
    
    {% for paragraph in paragraphs %}
    <p>{{ paragraph }}</p>
    {% endfor %}
    
    <div class="links">
        <h2>Related Articles</h2>
        <ul>
            {% for link in links %}
            <li><a href="{{ link.1 }}" rel="nofollow noopener noreferrer">{{ link.0 }}</a></li>
            {% endfor %}
        </ul>
    </div>
    
    <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; text-align: center; color: #999; font-size: 0.9em;">
        Total visitors to this collection: {{ visit_count }}
    </div>
</body>
</html>
