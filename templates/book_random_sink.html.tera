{% extends "base.html.tera" %}

{% block title %}{{ title }}{% endblock title %}

{% block content %}
    <h1>{{ title }}</h1>
    
    {% for image in images %}
    <figure style="margin: 20px 0; text-align: center;">
        <img src="{{ image.0 }}" alt="{{ image.1 }}" style="max-width: 100%; height: auto; border-radius: 8px;">
    </figure>
    {% endfor %}

    {% for paragraph in paragraphs %}
    <p>{{ paragraph | safe }}</p>
    {% endfor %}
    
    <div class="links">
        <h2>Related Articles</h2>
        <ul>
            {% for link in links %}
            <li><a href="{{ link.1 }}" rel="nofollow noopener noreferrer">{{ link.0 }}</a></li>
            {% endfor %}
        </ul>
    </div>
{% endblock content %}
