{% extends "base.html.tera" %}

{% block title %}{{ title | escape }}{% endblock title %}

{% block extra_styles %}
    .blog-meta { color: #586773; font-size: .95em; margin: -12px 0 30px; }
    .blog-section { max-width: 74ch; margin: 0 0 28px; }
    .blog-section h2 { margin: 26px 0 12px; }
    .blog-section p { line-height: 1.75; text-align: left; }
{% endblock extra_styles %}

{% block content %}
    <h1>{{ title | escape }}</h1>
    <p class="blog-meta">{{ kind | escape }} · {{ reading_minutes }} min read</p>
    {% if tagged_thread %}
    <nav aria-label="Related thread">
        <a href="{{ tagged_thread.tag_url | escape }}" rel="nofollow">#{{ tagged_thread.tag_label | escape }}</a>
        · <a href="{{ tagged_thread.paper_url | escape }}" rel="nofollow">{{ tagged_thread.paper_title | escape }}</a>
        · <a href="{{ tagged_thread.social_post_url | escape }}" rel="nofollow">Post by @{{ tagged_thread.social_username | escape }}</a>
    </nav>
    {% else %}
    <nav aria-label="Topics">
        Topics: {% for topic in topics %}<a href="/tags/{{ topic.slug | escape }}" rel="nofollow noopener noreferrer">#{{ topic.label | escape }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    </nav>
    {% endif %}
    
    {% for image in images %}
    <figure style="margin: 20px 0; text-align: center;">
        <img src="{{ image.0 | escape }}" alt="{{ image.1 | escape }}" style="max-width: 100%; height: auto; border-radius: 8px;">
    </figure>
    {% endfor %}

    {% for section in sections %}
    <section class="blog-section">
    {% if section.heading %}<h2>{{ section.heading | escape }}</h2>{% endif %}
    {% for paragraph in section.paragraphs %}
    <p>{% for part in paragraph %}{% if not loop.first %} {% endif %}{% if part.url %}<a href="{{ part.url | escape }}" rel="nofollow noopener noreferrer">{{ part.text | escape }}</a>{{ part.trailing | escape }}{% else %}{{ part.text | escape }}{% endif %}{% endfor %}</p>
    {% endfor %}
    </section>
    {% endfor %}
    
    <div class="links">
        <h2>Related Articles</h2>
        <ul>
            {% for link in links %}
            <li><a href="{{ link.1 | escape }}" rel="nofollow noopener noreferrer">{{ link.0 | escape }}</a></li>
            {% endfor %}
        </ul>
    </div>
{% endblock content %}
