{% extends "base.html.tera" %}

{% block title %}Classic Literature Archive{% endblock title %}

{% block content %}
    <h1>Classic Literature Archive</h1>
    
    <div class="intro" style="margin: 30px 0; font-style: italic; color: #555;">
        Welcome to our curated collection of classic literature. Explore timeless stories and profound insights from the world's greatest authors.
    </div>
    
    <div style="background: #fffbf0; border-left: 4px solid #f39c12; padding: 15px; margin: 20px 0; font-size: 0.95em; color: #555;">
        <strong>Note to human visitors:</strong> This might not be the site you were looking for.
    </div>
    
    {% for paragraph in paragraphs %}
    <p>{{ paragraph | safe }}</p>
    {% endfor %}

    
    <div class="links">
        <h2>Friends of the Archive</h2>
        <ul>
            <li><a href="https://herm.app/babbler/" rel="nofollow noopener noreferrer">Ardent Genesis</a></li>
            <li><a href="https://maurycyz.com/babble/entry_point" rel="nofollow noopener noreferrer">Journey Eclipse</a></li>
        </ul>
    </div>
    
    <div class="links" style="margin-top: 30px;">
        <h2>Featured Articles</h2>
        <ul>
            {% for link in links %}
            <li><a href="{{ link.1 }}" rel="nofollow noopener noreferrer">{{ link.0 }}</a></li>
            {% endfor %}
        </ul>
    </div>
    
    <div class="links">
        <h2>Poetry & Reflections</h2>
        <ul>
            {% for haiku_link in haiku_links %}
            <li><a href="{{ haiku_link.1 }}" rel="nofollow noopener noreferrer" style="font-style: italic;">{{ haiku_link.0 }}</a></li>
            {% endfor %}
        </ul>
    </div>
    
    <div class="links" style="margin-top: 30px;">
        <h2>Community & Discussion</h2>
        <ul>
            <li><a href="/social" rel="nofollow noopener noreferrer">🐦 SinkNet Social Feed</a> - See what the community is sharing</li>
            <li><a href="/social/user/cosmic_dreamer" rel="nofollow noopener noreferrer">Featured: @cosmic_dreamer</a></li>
            <li><a href="/social/user/silent_river42" rel="nofollow noopener noreferrer">Featured: @silent_river42</a></li>
        </ul>
    </div>
{% endblock content %}
