<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <meta name="referrer" content="no-referrer">
    <title>{% block title %}Classic Literature Archive{% endblock title %}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Georgia, serif;
            line-height: 1.6;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .navbar {
            background: #2c3e50;
            padding: 15px 0;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        .navbar-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .navbar-brand {
            color: #ecf0f1;
            font-size: 1.3em;
            text-decoration: none;
            font-weight: bold;
        }
        
        .navbar-brand:hover {
            color: #3498db;
        }
        
        .navbar-links {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            list-style: none;
        }
        
        .navbar-links a {
            color: #ecf0f1;
            text-decoration: none;
            padding: 8px 15px;
            border-radius: 4px;
            transition: all 0.3s;
        }
        
        .navbar-links a:hover {
            background: #34495e;
            color: #3498db;
        }
        
        .content {
            flex: 1;
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
            width: 100%;
        }
        
        h1 {
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
            margin-bottom: 30px;
        }
        
        h2 {
            color: #2c3e50;
            font-size: 1.2em;
            margin-top: 30px;
            margin-bottom: 15px;
        }
        
        p {
            margin-bottom: 20px;
            text-align: justify;
        }
        
        .links {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
        }
        
        .links ul {
            list-style: none;
            padding: 0;
        }
        
        .links li {
            margin: 10px 0;
        }
        
        .links a {
            color: #3498db;
            text-decoration: none;
            font-weight: 500;
        }
        
        .links a:hover {
            text-decoration: underline;
        }

        .post-content a.paper-link {
            color: #0969a2;
            text-decoration: underline;
            text-underline-offset: 2px;
        }

        .post-content a.paper-link:hover {
            color: #075985;
        }
        
        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            text-align: center;
            color: #999;
            font-size: 0.9em;
        }
        
        .site-footer {
            background: #2c3e50;
            color: #ecf0f1;
            padding: 20px 0;
            margin-top: auto;
        }
        
        .footer-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 20px;
            text-align: center;
        }
        
        .footer-text {
            margin-bottom: 10px;
            font-size: 0.95em;
        }
        
        .footer-text strong {
            color: #3498db;
            font-size: 1.1em;
        }
        
        .footer-note {
            font-size: 0.8em;
            opacity: 0.7;
            margin: 0;
        }
        
        @media (max-width: 650px) {
            .navbar-container { flex-direction: column; gap: 12px; }
            .navbar-links { justify-content: center; gap: 6px; }
        }
        {% block extra_styles %}{% endblock extra_styles %}
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand" rel="nofollow noopener noreferrer">Literature Archive</a>
            <ul class="navbar-links">
                <li><a href="/blog/blog-posts" rel="nofollow noopener noreferrer">Blog</a></li>
                <li><a href="/haiku/reflections" rel="nofollow noopener noreferrer">Haiku</a></li>
                <li><a href="/social" rel="nofollow noopener noreferrer">Social</a></li>
                <li><a href="/papers" rel="nofollow noopener noreferrer">Papers</a></li>
            </ul>
        </div>
    </nav>
    
    <div class="content">
        {% block content %}{% endblock content %}
    </div>
    
    <footer class="site-footer">
        <div class="footer-container">
            <p class="footer-text">
                📊 Page visits: 
                <span class="visit-stat">📚 Blog: <strong>{{ blog_visits | default(value=0) }}</strong></span> · 
                <span class="visit-stat">🍃 Haiku: <strong>{{ haiku_visits | default(value=0) }}</strong></span> · 
                <span class="visit-stat">💬 Social: <strong>{{ social_visits | default(value=0) }}</strong></span> ·
                <span class="visit-stat">📄 Papers: <strong>{{ paper_visits | default(value=0) }}</strong></span><br/>
                <span class="visit-stat">🌐 Total: <strong>{{ total_visits | default(value=0) }}</strong></span>
            </p>
        </div>
    </footer>
</body>
</html>
