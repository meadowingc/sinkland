# Standalone app defaults. Copy to .env for local configuration.
# Existing process environment variables take precedence over .env.
# For an installed Pi service, edit /etc/sinkland/sinkland.env instead:
# the installer sets loopback binding, Cloudflare trust, and persistent storage.
# Do not put Cloudflare Tunnel tokens or other secrets in this example.

# Listen address. Use 127.0.0.1:43796 when only local cloudflared should connect.
SINKLAND_BIND=0.0.0.0:43796

# Persistent visit data. Keep outside release directories; one app instance per directory.
# The Pi installer uses /var/lib/sinkland.
SINKLAND_STATE_DIR=./state

# JSON array of live HTTPS origins serving this same app; [] keeps links relative.
# Optional ports and a trailing / are allowed; no credentials, paths, queries,
# fragments, or wildcards. Invalid configuration fails startup.
# Example: SINKLAND_ORIGINS='["https://sink.example.com","https://pond.example.org"]'
SINKLAND_ORIGINS='[]'

# JSON array of other opt-in trap sites. Only add sites that agreed to receive traffic.
# Example: SINKLAND_FRIENDS='["https://friend.example.com/trap"]'
SINKLAND_FRIENDS='[]'

# Traffic protection applies to all clients and is shared across site aliases.
# Booleans must be true or false; numeric limits must be integers from 1 to 1000000.
SINKLAND_RATE_LIMIT_ENABLED=true
SINKLAND_RATE_LIMIT_IP_RPS=2
SINKLAND_RATE_LIMIT_IP_BURST=30
SINKLAND_RATE_LIMIT_GLOBAL_RPS=10
SINKLAND_RATE_LIMIT_GLOBAL_BURST=50
SINKLAND_RATE_LIMIT_CONCURRENCY=4

# Trust CF-Connecting-IP only from loopback peers. Enable only with trusted local
# Cloudflare forwarding and no untrusted access to that listener or another local proxy.
# The Pi installer enables this; standalone instances default to false.
SINKLAND_TRUST_CLOUDFLARE=false
